{
  "name": "ff-pane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm --filter @ff-pane/desktop run dev",
    "lint": "biome check . && node scripts/check-i18n.mjs",
    "test": "vitest run",
    "build": "pnpm -r run build",
    "smoke": "pnpm --filter @ff-pane/desktop run smoke",
    "test:e2e": "pnpm --filter @ff-pane/desktop run test:e2e",
    "package": "pnpm --filter @ff-pane/desktop run package"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
